### 5.4 Cadastrar Termo-higrômetro (Ambiente & Umidade)
# @name createStandardThermoHygrometer
POST {{TracLabs.API_HostAddress}}/api/v1/standardequipment
Content-Type: application/json
Authorization: Bearer {{supervisorToken}}

{
  "labTag": "PAD-TH-001",
  "name": "Termo-higrômetro Digital de Referência",
  "model": "testo 608-H2",
  "manufacturer": "Testo",
  "serialNumber": "TST-990011",
  "instrumentType": "Termo-higrômetro",
  "resolution": 0.1,
  "error": 0.05,
  "expandedUncertainty": 0.08,
  "coverageFactor": 2.0,
  "lastCalibrationDate": "2026-01-15T00:00:00Z",
  "calibrationDueDate": "2027-01-15T00:00:00Z",
  "calibrationCertificateNumber": "CAL-TH-2026-556",
  "calibratingLaboratory": "Lab Metrologia RBC",
  "currentLocation": "Sala de Calibração",
  "calibrationIntervalMonths": 12
