@TracLabs.API_HostAddress = http://localhost:5259

### 0. Status e Saúde do Banco de Dados (Público - Padrão TabNews)
GET {{TracLabs.API_HostAddress}}/api/v1/status

### 1. Autenticar como Supervisor
# @name loginSupervisor
POST {{TracLabs.API_HostAddress}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "supervisor@traclabs.com",
  "password": "Password123!"
}

### Extrair o Token do Supervisor
@supervisorToken = {{loginSupervisor.response.body.token}}

### 2. Autenticar como Técnico
# @name loginTecnico
POST {{TracLabs.API_HostAddress}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "tecnico@traclabs.com",
  "password": "Password123!"
}

### Extrair o Token do Técnico
@tecnicoToken = {{loginTecnico.response.body.token}}

### 3. Listar Clientes (Requer Técnico ou Supervisor)
GET {{TracLabs.API_HostAddress}}/api/v1/clients
Authorization: Bearer {{supervisorToken}}

### 4. Criar Cliente (Requer Supervisor - TaxId apenas números)
# @name createClient
POST {{TracLabs.API_HostAddress}}/api/v1/clients
Content-Type: application/json
Authorization: Bearer {{supervisorToken}}

{
  "name": "Laboratório de Análises Biológicas Ltda",
  "taxId": "12345678000199",
  "taxIdType": 0,
  "email": "contato@labbiologicas.com.br",
  "phone": "11999998888",
  "contactPerson": "Dra. Helena Souza",
  "street": "Av. Paulista, 1000",
  "city": "São Paulo",
  "state": "SP",
  "postalCode": "01310100"
}

### ID do Cliente Criado
@clientId = {{createClient.response.body.id}}

### 5. Cadastrar Padrões Metrológicos Obrigatórios (Balança, Termômetros, Barômetro e Higrômetro)

### 5.1 Cadastrar Balança Analítica Padrão
# @name createStandardBalance
POST {{TracLabs.API_HostAddress}}/api/v1/standardequipment
Content-Type: application/json
Authorization: Bearer {{supervisorToken}}

{
  "labTag": "PAD-BAL-001",
  "name": "Balança Analítica Padrão de Referência",
  "model": "XPE205",
  "manufacturer": "Mettler Toledo",
  "serialNumber": "MT-987654",
  "instrumentType": "Balança Analítica",
  "resolution": 0.00001,
  "error": 0.00002,
  "expandedUncertainty": 0.00004,
  "coverageFactor": 2.0,
  "lastCalibrationDate": "2026-01-15T00:00:00Z",
  "calibrationDueDate": "2027-01-15T00:00:00Z",
  "calibrationCertificateNumber": "CAL-BAL-2026-089",
  "calibratingLaboratory": "Lab Metrologia RBC",
  "acceptanceCriteria": "Erro <= 0.00005 g",
  "currentLocation": "Sala de Pesagem",
  "calibrationIntervalMonths": 12
}

@standardId = {{createStandardBalance.response.body.id}}

### 5.2 Cadastrar Termômetro de Imersão (Líquido/Água)
# @name createStandardLiquidThermometer
POST {{TracLabs.API_HostAddress}}/api/v1/standardequipment
Content-Type: application/json
Authorization: Bearer {{supervisorToken}}

{
  "labTag": "PAD-TER-LIQ-01",
  "name": "Termômetro Digital de Imersão para Água",
  "model": "Incoterm Digital Pro",
  "manufacturer": "Incoterm",
  "serialNumber": "INC-445566",
  "instrumentType": "Termômetro",
  "resolution": 0.01,
  "error": -0.02,
  "expandedUncertainty": 0.01,
  "coverageFactor": 2.0,
  "lastCalibrationDate": "2026-01-15T00:00:00Z",
  "calibrationDueDate": "2027-01-15T00:00:00Z",
  "calibrationCertificateNumber": "CAL-TER-2026-112",
  "calibratingLaboratory": "Lab Metrologia RBC",
  "currentLocation": "Bancada de Volume",
  "calibrationIntervalMonths": 12
}

@liquidThermId = {{createStandardLiquidThermometer.response.body.id}}

