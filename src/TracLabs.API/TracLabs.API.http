  "observations": "Calibração realizada de acordo com a ISO 4787 / ISO 8655.",
  "nominalVolumeMl": 100.0,
  "material": 0,
  "measurements": [
    { "runNumber": 1, "fullMassGrams": 199.982, "emptyMassGrams": 100.0, "waterTemperatureCelsius": 20.01, "ambientTemperatureCelsius": 20.2, "atmosphericPressureHpa": 1013.2, "relativeHumidityPercent": 50.1 },
