@thermoHygroId = {{createStandardThermoHygrometer.response.body.id}}

### 6. Listar Padrões Aptos para Uso
GET {{TracLabs.API_HostAddress}}/api/v1/standardequipment/usable
Authorization: Bearer {{supervisorToken}}

### 7. Cadastrar Equipamento do Cliente (Micropipeta 100-1000 µL)
# @name createEquipment
POST {{TracLabs.API_HostAddress}}/api/v1/equipment
Content-Type: application/json
Authorization: Bearer {{supervisorToken}}

{
  "labTag": "PIP-CLI-001",
  "name": "Micropipeta Monocanal Variável",
  "model": "Research Plus",
  "manufacturer": "Eppendorf",
  "serialNumber": "EP-123456",
  "instrumentType": "Micropipeta",
  "rangeMin": 100,
  "rangeMax": 1000,
  "unit": "µL",
  "resolution": 1,
  "clientId": "{{clientId}}",
  "currentLocation": "Bancada 02",
  "acceptanceCriteria": "Erro sistemático <= 1.0%"
}

### ID do Equipamento Criado
@equipmentId = {{createEquipment.response.body.id}}

### 8. Simular Cálculo de Calibração Volumétrica com Resolução Dinâmica dos Padrões (Sem salvar no banco)
POST {{TracLabs.API_HostAddress}}/api/v1/calibrations/volume/calculate
Content-Type: application/json
Authorization: Bearer {{tecnicoToken}}

{
  "nominalVolumeMl": 100.0,
  "material": 0,
  "balanceStandardId": "{{standardId}}",
  "liquidThermometerStandardId": "{{liquidThermId}}",
  "barometerStandardId": "{{barometerId}}",
  "thermoHygrometerStandardId": "{{thermoHygroId}}",
  "measurements": [
    { "runNumber": 1, "fullMassGrams": 199.982, "emptyMassGrams": 100.0, "waterTemperatureCelsius": 20.01, "ambientTemperatureCelsius": 20.2, "atmosphericPressureHpa": 1013.2, "relativeHumidityPercent": 50.1 },
    { "runNumber": 2, "fullMassGrams": 199.981, "emptyMassGrams": 100.0, "waterTemperatureCelsius": 20.02, "ambientTemperatureCelsius": 20.2, "atmosphericPressureHpa": 1013.2, "relativeHumidityPercent": 50.1 },
