    { "runNumber": 5, "fullMassGrams": 199.982, "emptyMassGrams": 100.0, "waterTemperatureCelsius": 20.02, "ambientTemperatureCelsius": 20.3, "atmosphericPressureHpa": 1013.1, "relativeHumidityPercent": 50.3 },
    { "runNumber": 6, "fullMassGrams": 199.984, "emptyMassGrams": 100.0, "waterTemperatureCelsius": 20.02, "ambientTemperatureCelsius": 20.3, "atmosphericPressureHpa": 1013.2, "relativeHumidityPercent": 50.2 },
    { "runNumber": 7, "fullMassGrams": 199.981, "emptyMassGrams": 100.0, "waterTemperatureCelsius": 20.01, "ambientTemperatureCelsius": 20.2, "atmosphericPressureHpa": 1013.3, "relativeHumidityPercent": 50.1 },
    { "runNumber": 8, "fullMassGrams": 199.983, "emptyMassGrams": 100.0, "waterTemperatureCelsius": 20.03, "ambientTemperatureCelsius": 20.2, "atmosphericPressureHpa": 1013.2, "relativeHumidityPercent": 50.0 },
