@page "/dashboard"
@inject IMetrologyDataService DataService
@inject NavigationManager Navigation

<div>
    <!-- Header with Action Buttons -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 style="font-size: 1.5rem; font-weight: 800; color: var(--trac-text-primary); margin: 0;">
                Dashboard Metrológico
            </h1>
            <p style="font-size: 0.875rem; color: var(--trac-text-secondary); margin: 0.25rem 0 0 0;">
                Visão operacional em tempo real &bull; Indicadores ISO/IEC 17025 e rastreabilidade RBC
            </p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <button class="trac-btn trac-btn-secondary trac-btn-sm" @onclick="LoadDashboardDataAsync" title="Atualizar dados do backend">
                <svg style="width: 14px; height: 14px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                Atualizar
            </button>
            <button class="trac-btn trac-btn-secondary trac-btn-sm" @onclick="@(() => Navigation.NavigateTo("/cadastros"))">
                <svg style="width: 14px; height: 14px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                Cadastros
            </button>
            <button class="trac-btn trac-btn-primary trac-btn-sm" @onclick="@(() => Navigation.NavigateTo("/calibracao"))">
                <svg style="width: 14px; height: 14px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                Iniciar Novo Ensaio
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="p-3 mb-4 d-flex justify-content-between align-items-center" style="background-color: var(--trac-status-danger-bg); border: 1px solid var(--trac-status-danger-border); border-radius: var(--trac-radius-md); color: var(--trac-danger-700);">
            <div class="d-flex align-items-center gap-2">
                <svg style="width: 20px; height: 20px; flex-shrink: 0;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span style="font-size: 0.875rem;">@_errorMessage</span>
            </div>
            <button class="trac-btn trac-btn-secondary trac-btn-sm" @onclick="LoadDashboardDataAsync">
                Tentar Novamente
            </button>
        </div>
    }

    <!-- 4 KPI Cards -->
    <div class="row mb-4">
        <!-- 1. Calibrações Ativas -->
        <div class="col-12 col-md-6 col-lg-3 mb-3">
            <div class="trac-stat-card">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="trac-stat-title">Calibrações em Andamento</span>
                </div>
                <div class="trac-stat-value">
                    @if (_isLoading)
                    {
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                    }
                    else
                    {
                        @_metrics.ActiveCalibrationsCount
                    }
                </div>
                <div class="trac-stat-subtitle">Ensaios gravimétricos em bancada</div>
            </div>
        </div>

        <!-- 2. Certificados Emitidos -->
        <div class="col-12 col-md-6 col-lg-3 mb-3">
            <div class="trac-stat-card">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="trac-stat-title">Certificados Emitidos (Mês)</span>
                </div>
                <div class="trac-stat-value">
                    @if (_isLoading)
                    {
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                    }
                    else
                    {
                        @_metrics.IssuedCertificatesMonthCount
                    }
                </div>
                <div class="trac-stat-subtitle">Com assinatura digital e QR Code</div>
            </div>
        </div>

        <!-- 3. Padrões a Vencer -->
        <div class="col-12 col-md-6 col-lg-3 mb-3">
            <div class="trac-stat-card" style="border-color: @(_metrics.ExpiringStandardsCount > 0 ? "var(--trac-warning-500)" : "var(--trac-border-default)");">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="trac-stat-title">Padrões a Vencer (30d)</span>
               </div>
                <div class="trac-stat-value" style="color: var(--trac-warning-600);">
                    @if (_isLoading)
                    {
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                    }
                    else
                    {
                        @_metrics.ExpiringStandardsCount
                    }
                </div>
                <div class="trac-stat-subtitle">Exigem renovação com laboratório RBC</div>
            </div>
        </div>

        <!-- 4. Não Conformidades -->
        <div class="col-12 col-md-6 col-lg-3 mb-3">
            <div class="trac-stat-card">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="trac-stat-title">Não Conformidades</span>
                </div>
                <div class="trac-stat-value" style="color: var(--trac-danger-600);">
                    @if (_isLoading)
                    {
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                    }
                    else
                    {
                        @_metrics.NonConformingCount
                    }
                </div>
                <div class="trac-stat-subtitle">Desvio superior ao erro admissível</div>
            </div>
        </div>
    </div>

    <!-- Middle Section: Expiring Standards Alert Table (ISO 17025 item 6.4.13) -->
    <div class="trac-card mb-4">
        <div class="trac-card-header">
            <div class="d-flex align-items-center gap-2">
                <svg style="width: 20px; height: 20px; color: var(--trac-warning-600);" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
                <span style="font-weight: 700; font-size: 0.9375rem; color: var(--trac-text-primary);">
                    Alerta de Validade de Instrumentos Padrão RBC (ISO/IEC 17025:2017 item 6.4.13)
                </span>
            </div>
            <span class="trac-badge trac-badge-neutral">@_expiringStandards.Count instrumentos críticos</span>
        </div>

        <div class="trac-card-body p-0">
            <div class="trac-table-container" style="border: none; border-radius: 0;">
                <table class="trac-table">
                    <thead>
                        <tr>
                            <th>Tag Lab</th>
                            <th>Instrumento Padrão</th>
                            <th>Papel Metrológico</th>
                            <th>Nº Certificado RBC</th>
                            <th>Laboratório Emissor</th>
                            <th>Vencimento</th>
                            <th>Prazo Restante</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_isLoading)
                        {
                            <tr>
                                <td colspan="8" class="text-center p-4">
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    Carregando padrões em tempo real...
                                </td>
                            </tr>
                        }
                        else if (_expiringStandards.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="text-center p-4 text-muted">
                                    Nenhum padrão com validade próxima a vencer no período de 30 dias.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var std in _expiringStandards)
                            {
                                <tr>
                                    <td>
                                        <strong class="trac-mono" style="color: var(--trac-brand-primary);">@std.LabTag</strong>
                                    </td>
                                    <td>
                                        <div style="font-weight: 600;">@std.Name</div>
                                        <div style="font-size: 0.75rem; color: var(--trac-text-muted);">@std.Manufacturer @std.Model (S/N: @std.SerialNumber)</div>
                                    </td>
                                    <td>
                                        <span class="trac-badge trac-badge-neutral">@std.Role</span>
                                    </td>
                                    <td class="trac-mono">@std.CalibrationCertificateNumber</td>
                                    <td>@std.CalibratingLaboratory</td>
                                    <td class="trac-mono">@std.CalibrationDueDate.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @if (std.DaysUntilExpiry <= 7)
                                        {
                                            <span class="trac-badge trac-badge-danger d-inline-flex align-items-center gap-1">
                                                <span class="trac-pulse-dot" style="background-color: var(--trac-danger-500); width: 6px; height: 6px;"></span>
                                                Crítico (@std.DaysUntilExpiry dias)
                                            </span>
                                        }
                                        else if (std.DaysUntilExpiry <= 30)
                                        {
                                            <span class="trac-badge trac-badge-warning">
                                                Alerta (@std.DaysUntilExpiry dias)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="trac-badge trac-badge-success">
                                                Vigente (@std.DaysUntilExpiry dias)
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <button class="trac-btn trac-btn-secondary trac-btn-sm" @onclick="@(() => Navigation.NavigateTo($"/cadastros?tab=standards&id={std.Id}"))">
                                            Ver Padrão
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Lower Section: Recent Calibration Timeline Feed -->
    <div class="trac-card">
        <div class="trac-card-header">
            <span style="font-weight: 700; font-size: 0.9375rem; color: var(--trac-text-primary);">
                Linha do Tempo de Atividades Recentes
            </span>
        </div>
        <div class="trac-card-body">
            @if (_isLoading)
            {
                <div class="text-center p-4">
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    Carregando atividades recentes...
                </div>
            }
            else if (_recentEvents.Count == 0)
            {
                <div class="text-center p-4 text-muted">
                    Nenhuma calibração recente registrada no sistema.
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var ev in _recentEvents)
                    {
                        <div class="d-flex align-items-start gap-3 p-3" style="background-color: var(--trac-bg-surface-elevated); border: 1px solid var(--trac-border-default); border-radius: var(--trac-radius-md);">
                            <div class="p-2" style="border-radius: 50%; background-color: @(ev.Result == CalibrationResult.Conforming ? "var(--trac-status-conforming-bg)" : ev.Result == CalibrationResult.NonConforming ? "var(--trac-status-danger-bg)" : "var(--trac-brand-subtle)"); color: @(ev.Result == CalibrationResult.Conforming ? "var(--trac-success-600)" : ev.Result == CalibrationResult.NonConforming ? "var(--trac-danger-600)" : "var(--trac-brand-primary)");">
                                @if (ev.Result == CalibrationResult.Conforming)
                                {
                                    <svg style="width: 18px; height: 18px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                    </svg>
                                }
                                else if (ev.Result == CalibrationResult.NonConforming)
                                {
                                    <svg style="width: 18px; height: 18px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                    </svg>
                                }
                                else
                                {
                                    <svg style="width: 18px; height: 18px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                }
                            </div>

                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span style="font-weight: 700; font-size: 0.875rem; color: var(--trac-text-primary);">@ev.Title</span>
                                    <span class="trac-mono" style="font-size: 0.75rem; color: var(--trac-text-muted);">@ev.TimeString</span>
                                </div>
                                <div style="font-size: 0.8125rem; color: var(--trac-text-secondary); margin-top: 0.2rem;">
                                    Instrumento: <strong class="trac-mono">@ev.EquipmentTag</strong> &bull; Cliente: <strong>@ev.ClientName</strong> &bull; Operador: <em>@ev.OperatorName</em>
                                </div>
                                <div style="font-size: 0.75rem; color: var(--trac-text-muted); margin-top: 0.35rem; font-style: italic;">
                                    @ev.Details
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private DashboardMetricsDto _metrics = new();
    private List<StandardEquipmentDto> _expiringStandards = new();
    private List<CalibrationTimelineEventDto> _recentEvents = new();
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardDataAsync();
    }

    private async Task LoadDashboardDataAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _metrics = await DataService.GetDashboardMetricsAsync();
            _expiringStandards = await DataService.GetExpiringStandardsAsync(30);
            _recentEvents = await DataService.GetRecentEventsAsync();
        }
        catch (Exception)
        {
            _errorMessage = "Não foi possível carregar os dados em tempo real da API. Verifique a conexão com o servidor.";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
