    // Modal Helpers (List View)
    private void OpenNewClientModal()
    {
        if (!IsSupervisor) return;
        _newClient = new ClientDto();
        _showClientModal = true;
    }
    private void CloseClientModal() => _showClientModal = false;
    private async Task SaveClient()
    {
        if (!IsSupervisor) return;
        try
        {
            await DataService.SaveClientAsync(_newClient);
            _showClientModal = false;
            await LoadDataAsync();
            NotificationModal.ShowSuccess("Cliente Cadastrado", $"O cliente '{_newClient.Name}' foi cadastrado com sucesso.");
        }
        catch (Exception ex)
        {
            NotificationModal.ShowError("Erro ao Salvar Cliente", ex.Message, ex.ToString());
        }
    }

    private void OpenNewEquipmentModal()
    {
        _newEquipment = new ClientEquipmentDto();
        _showEquipmentModal = true;
    }
    private void CloseEquipmentModal() => _showEquipmentModal = false;
    private async Task SaveEquipment()
    {
        try
        {
            var client = _clients.FirstOrDefault(c => c.Id == _newEquipment.ClientId);
            if (client != null) _newEquipment.ClientName = client.Name;
            await DataService.SaveClientEquipmentAsync(_newEquipment);
            _showEquipmentModal = false;
            await LoadDataAsync();
            NotificationModal.ShowSuccess("Equipamento Cadastrado", $"O equipamento '{_newEquipment.LabTag}' foi cadastrado com sucesso e está pronto para ensaios.");
        }
        catch (Exception ex)
        {
            NotificationModal.ShowError("Erro ao Salvar Equipamento", ex.Message, ex.ToString());
        }
    }

    private void OpenNewStandardModal()
    {
        if (!IsSupervisor) return;
        _newStandard = new StandardEquipmentDto
        {
            LastCalibrationDate = DateTime.UtcNow,
            CalibrationDueDate = DateTime.UtcNow.AddYears(1)
        };
        _standardStep = 1;
        _showStandardModal = true;
    }
    private void CloseStandardModal() => _showStandardModal = false;
    private async Task SaveStandard()
    {
        if (!IsSupervisor) return;
        try
        {
            await DataService.SaveStandardEquipmentAsync(_newStandard);
            _showStandardModal = false;
            await LoadDataAsync();
            NotificationModal.ShowSuccess("Padrão Cadastrado", $"O padrão metrológico '{_newStandard.LabTag}' foi registrado com sucesso.");
        }
        catch (Exception ex)
        {
            NotificationModal.ShowError("Erro ao Salvar Padrão", ex.Message, ex.ToString());
        }
    }

    // Standard Actions Modals (Full View)
    private string? _standardErrorMessage;

    private void OpenEditStandardModal()
    {
        if (!IsSupervisor || _selectedStandard == null) return;
        _standardErrorMessage = null;
        _showEditStandardModal = true;
    }
    private void CloseEditStandardModal()
    {
        _standardErrorMessage = null;
        _showEditStandardModal = false;
    }
    private async Task SaveEditStandard()
    {
        if (!IsSupervisor || _selectedStandard == null) return;
        try
        {
            _standardErrorMessage = null;
            await DataService.UpdateStandardAsync(_selectedStandard);
            _showEditStandardModal = false;
            await LoadDataAsync();
            var reloaded = _standards.FirstOrDefault(s => s.Id == _selectedStandard.Id || s.LabTag == _selectedStandard.LabTag);
            if (reloaded != null) _selectedStandard = reloaded;
        }
        catch (Exception ex)
        {
            _standardErrorMessage = $"Erro ao salvar alterações: {ex.Message}";
        }
    }

    private void OpenSendToCalibrationModal()
    {
        if (!IsSupervisor || _selectedStandard == null) return;
        _sendCalibLab = _selectedStandard.CalibratingLaboratory;
        _sendCalibReturnDate = DateTime.UtcNow.AddDays(30);
        _showSendToCalibrationModal = true;
    }
    private void CloseSendToCalibrationModal() => _showSendToCalibrationModal = false;
    private async Task ConfirmSendToCalibration()
    {
        if (!IsSupervisor || _selectedStandard == null) return;
        var guid = GetStandardGuid(_selectedStandard);
        await DataService.SendStandardToCalibrationAsync(guid, _sendCalibLab, _sendCalibReturnDate);
        _selectedStandard.Status = StandardEquipmentStatus.InCalibration;
        _selectedStandard.CalibratingLaboratory = _sendCalibLab;
        _showSendToCalibrationModal = false;
        await LoadDataAsync();
        var reloaded = _standards.FirstOrDefault(s => s.Id == _selectedStandard.Id || s.LabTag == _selectedStandard.LabTag);
        if (reloaded != null) _selectedStandard = reloaded;
    }

    private void OpenRegisterCertModal()
    {
        if (!IsSupervisor || _selectedStandard == null) return;
        _newStandardCert = new StandardCertificateDto
        {
            StandardEquipmentId = GetStandardGuid(_selectedStandard),
            CalibratingLaboratory = _selectedStandard.CalibratingLaboratory,
            CalibrationDate = DateTime.UtcNow,
            CalibrationDueDate = DateTime.UtcNow.AddYears(1),
            CalibrationRangeMin = _selectedStandard.RangeMin,
            CalibrationRangeMax = _selectedStandard.RangeMax,
            CoverageFactor = _selectedStandard.CoverageFactor > 0 ? _selectedStandard.CoverageFactor : 2.0m,
            ExpandedUncertainty = _selectedStandard.ExpandedUncertainty,
            Error = _selectedStandard.Error,
            Correction = _selectedStandard.Correction,
            IsActive = true
        };
        _showRegisterCertModal = true;
    }
    private void CloseRegisterCertModal() => _showRegisterCertModal = false;
    private async Task SaveNewStandardCertificate()
    {
        if (!IsSupervisor || _selectedStandard == null) return;
        var guid = GetStandardGuid(_selectedStandard);
        await DataService.RegisterStandardCertificateAsync(guid, _newStandardCert);
        _standardCertificates = await DataService.GetStandardCertificatesAsync(guid);
        _showRegisterCertModal = false;
        await LoadDataAsync();
        var reloaded = _standards.FirstOrDefault(s => s.Id == _selectedStandard.Id || s.LabTag == _selectedStandard.LabTag);
        if (reloaded != null) _selectedStandard = reloaded;
    }

    private static string GetStandardRoleDisplayName(StandardRole role) => role switch
    {
        StandardRole.Balance => "Balança Analítica",
        StandardRole.LiquidThermometer => "Termômetro de Imersão (Água)",
        StandardRole.Barometer => "Barômetro",
        StandardRole.ThermoHygrometer => "Termo-Higrômetro",
        StandardRole.AmbientThermometer => "Termômetro Ambiente",
        StandardRole.Hygrometer => "Higrômetro",
        StandardRole.Pycnometer => "Picnômetro",
        StandardRole.ReferenceWeights => "Pesos Padrão",
        StandardRole.Other => "Densímetro Digital / Outro",
        _ => role.ToString()
    };
