@code {
    [SupplyParameterFromQuery(Name = "tab")]
    public string? QueryTab { get; set; }

    [SupplyParameterFromQuery(Name = "id")]
    public string? QueryId { get; set; }

    private string _activeTab = "clients";
    private List<ClientDto> _clients = new();
    private List<ClientDto> _filteredClients = new();
    private List<ClientEquipmentDto> _equipments = new();
    private List<ClientEquipmentDto> _filteredEquipments = new();
    private List<StandardEquipmentDto> _standards = new();
    private List<StandardEquipmentDto> _filteredStandards = new();

    private string _searchClient = "";
    private string _searchEquipment = "";
    private string _searchStandard = "";

    // Selected items for Full Views (R4)
    private ClientDto? _selectedClient;
    private ClientEquipmentDto? _selectedEquipment;
    private StandardEquipmentDto? _selectedStandard;

    // Full View Data
    private List<ClientEquipmentDto> _selectedClientEquipments = new();
    private List<ClientEquipmentDto> _filteredClientEquipments = new();
    private string _equipmentFilter = string.Empty;

    private List<CertificateDto> _equipmentCertificates = new();
    private List<StandardCertificateDto> _standardCertificates = new();
    private List<StandardCalibrationUsageDto> _standardUsages = new();

    // Standard Action Modals (R3, R4)
    private bool _showEditStandardModal = false;
    private bool _showSendToCalibrationModal = false;
    private string _sendCalibLab = string.Empty;
    private DateTime _sendCalibReturnDate = DateTime.UtcNow.AddDays(30);

    private bool _showRegisterCertModal = false;
    private StandardCertificateDto _newStandardCert = new();

    // Creation Modals state
    private bool _showClientModal = false;
    private ClientDto _newClient = new();

    private bool _showEquipmentModal = false;
    private ClientEquipmentDto _newEquipment = new();

    private bool _showStandardModal = false;
    private int _standardStep = 1;
    private StandardEquipmentDto _newStandard = new()
    {
        LastCalibrationDate = DateTime.UtcNow,
        CalibrationDueDate = DateTime.UtcNow.AddYears(1)
    };

    private bool IsSupervisor => UserContext.CurrentUser.Role == UserRole.Supervisor;
    private bool IsTecnico => UserContext.CurrentUser.Role == UserRole.Tecnico;

    protected override async Task OnInitializedAsync()
    {
        UserContext.OnUserChanged += OnUserChanged;
        await LoadDataAsync();
    }

    private void OnUserChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        UserContext.OnUserChanged -= OnUserChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(QueryTab))
        {
            _activeTab = QueryTab.ToLowerInvariant();
        }

        if (!string.IsNullOrWhiteSpace(QueryId))
        {
            await HandleQueryIdAsync(QueryId);
        }
    }

    private async Task HandleQueryIdAsync(string queryId)
    {
        if (_activeTab == "standards")
        {
            var std = _standards.FirstOrDefault(s =>
                s.Id.Equals(queryId, StringComparison.OrdinalIgnoreCase) ||
                s.LabTag.Equals(queryId, StringComparison.OrdinalIgnoreCase));
            if (std != null)
            {
                await ViewStandardDetails(std);
                return;
            }
        }
        else if (_activeTab == "equipment")
        {
            var eq = _equipments.FirstOrDefault(e =>
                e.Id.Equals(queryId, StringComparison.OrdinalIgnoreCase) ||
                e.LabTag.Equals(queryId, StringComparison.OrdinalIgnoreCase));
            if (eq != null)
            {
                await ViewEquipmentDetails(eq);
                return;
            }
        }
        else if (_activeTab == "clients")
        {
            var cli = _clients.FirstOrDefault(c =>
                c.Id.Equals(queryId, StringComparison.OrdinalIgnoreCase) ||
                c.TaxId.Equals(queryId, StringComparison.OrdinalIgnoreCase));
            if (cli != null)
            {
                ViewClientDetails(cli);
                return;
            }
        }

        // Fallback global search
        var stdFallback = _standards.FirstOrDefault(s =>
            s.Id.Equals(queryId, StringComparison.OrdinalIgnoreCase) ||
            s.LabTag.Equals(queryId, StringComparison.OrdinalIgnoreCase));
        if (stdFallback != null)
        {
            await ViewStandardDetails(stdFallback);
            return;
        }

        var eqFallback = _equipments.FirstOrDefault(e =>
            e.Id.Equals(queryId, StringComparison.OrdinalIgnoreCase) ||
            e.LabTag.Equals(queryId, StringComparison.OrdinalIgnoreCase));
        if (eqFallback != null)
        {
            await ViewEquipmentDetails(eqFallback);
            return;
        }

        var cliFallback = _clients.FirstOrDefault(c =>
            c.Id.Equals(queryId, StringComparison.OrdinalIgnoreCase) ||
            c.TaxId.Equals(queryId, StringComparison.OrdinalIgnoreCase));
        if (cliFallback != null)
        {
            ViewClientDetails(cliFallback);
        }
    }

    private async Task LoadDataAsync()
    {
        _clients = await DataService.GetClientsAsync();
        _filteredClients = _clients;

        _equipments = await DataService.GetClientEquipmentAsync();
        _filteredEquipments = _equipments;

        _standards = await DataService.GetStandardEquipmentAsync();
        _filteredStandards = _standards;

        if (_selectedClient != null)
        {
            _selectedClientEquipments = _equipments.Where(e => e.ClientId == _selectedClient.Id).ToList();
            FilterCustomerEquipment();
        }
    }

    private void SetTab(string tab)
    {
        _activeTab = tab;
        _selectedClient = null;
        _selectedEquipment = null;
        _selectedStandard = null;
    }

    private void FilterClients()
    {
        if (string.IsNullOrWhiteSpace(_searchClient))
        {
            _filteredClients = _clients;
            return;
        }
        _filteredClients = _clients.Where(c => c.Name.Contains(_searchClient, StringComparison.OrdinalIgnoreCase) ||
                                               c.TaxId.Contains(_searchClient, StringComparison.OrdinalIgnoreCase) ||
                                               c.City.Contains(_searchClient, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private void FilterEquipment()
    {
        if (string.IsNullOrWhiteSpace(_searchEquipment))
        {
            _filteredEquipments = _equipments;
            return;
        }
        _filteredEquipments = _equipments.Where(e => e.LabTag.Contains(_searchEquipment, StringComparison.OrdinalIgnoreCase) ||
                                                     e.Description.Contains(_searchEquipment, StringComparison.OrdinalIgnoreCase) ||
                                                     e.ClientName.Contains(_searchEquipment, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private void FilterStandards()
    {
        if (string.IsNullOrWhiteSpace(_searchStandard))
        {
            _filteredStandards = _standards;
            return;
        }
        _filteredStandards = _standards.Where(s => s.LabTag.Contains(_searchStandard, StringComparison.OrdinalIgnoreCase) ||
                                                   s.Name.Contains(_searchStandard, StringComparison.OrdinalIgnoreCase) ||
                                                   s.CalibrationCertificateNumber.Contains(_searchStandard, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private void ViewClientDetails(ClientDto client)
    {
        _selectedClient = client;
        _selectedEquipment = null;
        _selectedStandard = null;
        _activeTab = "clients";
        _selectedClientEquipments = _equipments.Where(e => e.ClientId == client.Id).ToList();
        _filteredClientEquipments = _selectedClientEquipments;
        _equipmentFilter = string.Empty;
    }

    private void FilterCustomerEquipment()
    {
        if (string.IsNullOrWhiteSpace(_equipmentFilter))
        {
            _filteredClientEquipments = _selectedClientEquipments;
            return;
        }

        _filteredClientEquipments = _selectedClientEquipments.Where(e =>
            e.LabTag.Contains(_equipmentFilter, StringComparison.OrdinalIgnoreCase) ||
            e.Description.Contains(_equipmentFilter, StringComparison.OrdinalIgnoreCase) ||
            e.Manufacturer.Contains(_equipmentFilter, StringComparison.OrdinalIgnoreCase) ||
            e.Model.Contains(_equipmentFilter, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private async Task ViewEquipmentDetails(ClientEquipmentDto equipment)
    {
        _selectedEquipment = equipment;
        _selectedClient = null;
        _selectedStandard = null;
        _activeTab = "equipment";
        var allCerts = await DataService.GetCertificatesAsync();
        _equipmentCertificates = allCerts.Where(c =>
            c.EquipmentTag.Equals(equipment.LabTag, StringComparison.OrdinalIgnoreCase) ||
            c.EquipmentDescription.Equals(equipment.Description, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private async Task ViewStandardDetails(StandardEquipmentDto standard)
    {
        _selectedStandard = standard;
        _selectedClient = null;
        _selectedEquipment = null;
        _activeTab = "standards";
        var guid = GetStandardGuid(standard);
        _standardCertificates = await DataService.GetStandardCertificatesAsync(guid);
        _standardUsages = await DataService.GetStandardCalibrationsUsedAsync(guid);
    }

    private void BackToList()
    {
        _selectedClient = null;
        _selectedEquipment = null;
        _selectedStandard = null;
    }

    private Guid GetStandardGuid(StandardEquipmentDto standard)
    {
        if (Guid.TryParse(standard.Id, out var g)) return g;
        return standard.LabTag switch
        {
            "PAD-BAL-01" => MockMetrologyDataService.StandardBalanceId,
            "PAD-TERM-01" => MockMetrologyDataService.StandardThermometerId,
            "PAD-BAR-01" => MockMetrologyDataService.StandardBarometerId,
            "PAD-HIG-01" => MockMetrologyDataService.StandardHygrometerId,
            "PAD-PES-01" => MockMetrologyDataService.StandardWeightsId,
            "PAD-TERAMB-01" => MockMetrologyDataService.StandardAmbientThermometerId,
            "PAD-HIG-02" => MockMetrologyDataService.StandardStandHygrometerId,
            "PAD-PIC-01" => MockMetrologyDataService.StandardPycnometerId,
            "PAD-PIC-02" => MockMetrologyDataService.StandardPycnometerExpiredId,
            _ => standard.Id switch
            {
                "pad-bal-01" => MockMetrologyDataService.StandardBalanceId,
                "pad-term-01" => MockMetrologyDataService.StandardThermometerId,
                "pad-bar-01" => MockMetrologyDataService.StandardBarometerId,
                "pad-hig-01" => MockMetrologyDataService.StandardHygrometerId,
                "pad-pes-01" => MockMetrologyDataService.StandardWeightsId,
                "pad-teramb-01" => MockMetrologyDataService.StandardAmbientThermometerId,
                "pad-hig-02" => MockMetrologyDataService.StandardStandHygrometerId,
                "pad-pic-01" => MockMetrologyDataService.StandardPycnometerId,
                "pad-pic-02" => MockMetrologyDataService.StandardPycnometerExpiredId,
                _ => Guid.NewGuid()
            }
        };
    }

