@page "/"
@inject IUserContextService UserContext
@inject IThemeService ThemeService
@inject NavigationManager Navigation

<div>
    <!-- Welcome Hero -->
    <div class="trac-card mb-4" style="background: linear-gradient(135deg, var(--trac-bg-surface) 0%, var(--trac-brand-subtle) 100%);">
        <div class="trac-card-body p-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="trac-badge trac-badge-info">ISO/IEC 17025:2017</span>
                        <span class="trac-badge trac-badge-neutral">RBC / Cgcre</span>
                    </div>
                    <h1 style="font-size: 1.75rem; font-weight: 800; color: var(--trac-text-primary); margin: 0;">
                        Bem-vindo ao TracLabs Metrology
                    </h1>
                    <p style="font-size: 0.9375rem; color: var(--trac-text-secondary); margin-top: 0.5rem; max-width: 680px;">
                        Sistema de gerenciamento metrológico para ensaios gravimétricos volumétricos, controle de instrumentos padrão RBC, cálculo de incertezas e emissão de certificados oficiais.
                    </p>
                </div>
                <div class="p-3" style="background-color: var(--trac-bg-surface-elevated); border: 1px solid var(--trac-border-default); border-radius: var(--trac-radius-lg); min-width: 240px;">
                    <div style="font-size: 0.75rem; color: var(--trac-text-muted); text-transform: uppercase; font-weight: 600;">Sessão Ativa</div>
                    <div class="d-flex align-items-center gap-2 mt-1">
                        <span style="width: 28px; height: 28px; border-radius: 50%; background-color: var(--trac-brand-primary); color: #FFFFFF; font-size: 0.8125rem; font-weight: 700; display: inline-flex; align-items: center; justify-content: center;">
                            @UserContext.CurrentUser.AvatarInitials
                        </span>
                        <div>
                            <div style="font-weight: 700; font-size: 0.875rem; color: var(--trac-text-primary);">@UserContext.CurrentUser.Name</div>
                            <div style="font-size: 0.75rem; color: var(--trac-text-secondary);">@UserContext.CurrentUser.RoleDescription</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Navigation Hub (4 Core Workspaces) -->
    <h2 style="font-size: 1.125rem; font-weight: 700; color: var(--trac-text-primary); margin-bottom: 1rem;">
        Fluxos de Trabalho e Módulos Principais
    </h2>

    <div class="row mb-4">
        <!-- 1. Ensaio Gravimétrico -->
        <div class="col-12 col-md-6 col-lg-3 mb-3">
            <div class="trac-card h-100 d-flex flex-column" style="cursor: pointer;" @onclick="@(() => Navigation.NavigateTo("/calibracao"))">
                <div class="trac-card-body d-flex flex-column flex-grow-1">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="p-2" style="background-color: var(--trac-brand-subtle); border-radius: var(--trac-radius-md); color: var(--trac-brand-primary);">
                            <svg style="width: 24px; height: 24px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
                            </svg>
                        </div>
                        <span class="trac-badge trac-badge-success">Interativo</span>
                    </div>
                    <h3 style="font-size: 1rem; font-weight: 700; margin: 0 0 0.5rem 0; color: var(--trac-text-primary);">
                        Calibração Volumétrica
                    </h3>
                    <p style="font-size: 0.8125rem; color: var(--trac-text-secondary); margin: 0 0 1rem 0; flex-grow: 1;">
                        Bancada gravimétrica conforme ISO 4787 / 8655. Cálculo em tempo real de densidades (Tanaka/Spieweck), Z-factor e incertezas.
                    </p>
                    <span class="trac-btn trac-btn-primary trac-btn-sm w-100">
                        Abrir Bancada Gravimétrica &rarr;
                    </span>
                </div>
            </div>
        </div>

        <!-- 2. Dashboard Metrológico -->
        <div class="col-12 col-md-6 col-lg-3 mb-3">
            <div class="trac-card h-100 d-flex flex-column" style="cursor: pointer;" @onclick="@(() => Navigation.NavigateTo("/dashboard"))">
                <div class="trac-card-body d-flex flex-column flex-grow-1">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="p-2" style="background-color: var(--trac-status-info-bg); border-radius: var(--trac-radius-md); color: var(--trac-info-600);">
                            <svg style="width: 24px; height: 24px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                            </svg>
                        </div>
                        <span class="trac-badge trac-badge-info">Operacional</span>
                    </div>
                    <h3 style="font-size: 1rem; font-weight: 700; margin: 0 0 0.5rem 0; color: var(--trac-text-primary);">
                        Dashboard Metrológico
                    </h3>
                    <p style="font-size: 0.8125rem; color: var(--trac-text-secondary); margin: 0 0 1rem 0; flex-grow: 1;">
                        Indicadores de produção, calibrações em curso, linha do tempo operacional e alertas de vencimento de padrões RBC.
                    </p>
                    <span class="trac-btn trac-btn-secondary trac-btn-sm w-100">
                        Visualizar Indicadores &rarr;
                    </span>
                </div>
            </div>
        </div>

        <!-- 3. Cadastros -->
        <div class="col-12 col-md-6 col-lg-3 mb-3">
            <div class="trac-card h-100 d-flex flex-column" style="cursor: pointer;" @onclick="@(() => Navigation.NavigateTo("/cadastros"))">
                <div class="trac-card-body d-flex flex-column flex-grow-1">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="p-2" style="background-color: var(--trac-status-warning-bg); border-radius: var(--trac-radius-md); color: var(--trac-warning-600);">
                            <svg style="width: 24px; height: 24px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                            </svg>
                        </div>
                        <span class="trac-badge trac-badge-warning">Gestão</span>
                    </div>
                    <h3 style="font-size: 1rem; font-weight: 700; margin: 0 0 0.5rem 0; color: var(--trac-text-primary);">
                        Cadastros Integrados
                    </h3>
                    <p style="font-size: 0.8125rem; color: var(--trac-text-secondary); margin: 0 0 1rem 0; flex-grow: 1;">
                        Gerenciamento de clientes, equipamentos sob calibração e padrões de referência RBC com rastreabilidade metrológica.
                    </p>
                    <span class="trac-btn trac-btn-secondary trac-btn-sm w-100">
                        Gerenciar Cadastros &rarr;
                    </span>
                </div>
            </div>
        </div>

        <!-- 4. Certificados Metrológicos -->
        <div class="col-12 col-md-6 col-lg-3 mb-3">
            <div class="trac-card h-100 d-flex flex-column" style="cursor: pointer;" @onclick="@(() => Navigation.NavigateTo("/certificados"))">
                <div class="trac-card-body d-flex flex-column flex-grow-1">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="p-2" style="background-color: var(--trac-status-conforming-bg); border-radius: var(--trac-radius-md); color: var(--trac-success-600);">
                            <svg style="width: 24px; height: 24px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                        </div>
                        <span class="trac-badge trac-badge-neutral">ISO 17025</span>
                    </div>
                    <h3 style="font-size: 1rem; font-weight: 700; margin: 0 0 0.5rem 0; color: var(--trac-text-primary);">
                        Certificados Oficiais
                    </h3>
                    <p style="font-size: 0.8125rem; color: var(--trac-text-secondary); margin: 0 0 1rem 0; flex-grow: 1;">
                        Visualização timbrada em A4 com rastreabilidade RBC, QR Code de validação, hash SHA-256 e ciclo de aprovação segregado.
                    </p>
                    <span class="trac-btn trac-btn-secondary trac-btn-sm w-100">
                        Consultar Certificados &rarr;
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Metrological Rigor Card -->
    <div class="row">
        <div class="col-12 mb-3">
            <div class="trac-card">
                <div class="trac-card-header">
                    <span style="font-weight: 700; font-size: 0.9375rem; color: var(--trac-text-primary);">
                        Rigor Matemático e Rastreabilidade Normativa
                    </span>
                    <span class="trac-badge trac-badge-info">Cálculos Puros</span>
                </div>
                <div class="trac-card-body">
                    <div class="row">
                        <div class="col-12 col-md-6 col-lg-3 mb-3">
                            <div class="p-3 h-100" style="background-color: var(--trac-bg-surface-elevated); border: 1px solid var(--trac-border-default); border-radius: var(--trac-radius-md);">
                                <div style="font-weight: 600; font-size: 0.875rem; color: var(--trac-text-primary);">Densidade da Água (Tanaka et al.)</div>
                                <div style="font-size: 0.75rem; color: var(--trac-text-muted); margin-top: 0.25rem;">
                                    Fórmula de referência internacional recomendada pela ISO 4787 para água pura desaerada em função da temperatura exata.
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 col-lg-3 mb-3">
                            <div class="p-3 h-100" style="background-color: var(--trac-bg-surface-elevated); border: 1px solid var(--trac-border-default); border-radius: var(--trac-radius-md);">
                                <div style="font-weight: 600; font-size: 0.875rem; color: var(--trac-text-primary);">Densidade do Ar (Spieweck)</div>
                                <div style="font-size: 0.75rem; color: var(--trac-text-muted); margin-top: 0.25rem;">
                                    Compensação barométrica e higrométrica para empuxo do ar sobre a massa aparente da água e massas padrão de referência.
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 col-lg-3 mb-3">
                            <div class="p-3 h-100" style="background-color: var(--trac-bg-surface-elevated); border: 1px solid var(--trac-border-default); border-radius: var(--trac-radius-md);">
                                <div style="font-weight: 600; font-size: 0.875rem; color: var(--trac-text-primary);">Fator Gravimétrico Z</div>
                                <div style="font-size: 0.75rem; color: var(--trac-text-muted); margin-top: 0.25rem;">
                                    Integra empuxo do ar, densidade dos pesos de calibração (8.0 g/cm³) e dilatação volumétrica cúbica (&gamma;) do material vítreo ou polimérico.
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 col-lg-3 mb-3">
                            <div class="p-3 h-100" style="background-color: var(--trac-bg-surface-elevated); border: 1px solid var(--trac-border-default); border-radius: var(--trac-radius-md);">
                                <div style="font-weight: 600; font-size: 0.875rem; color: var(--trac-text-primary);">Incerteza Expandida U (GUM / JCGM 100)</div>
                                <div style="font-size: 0.75rem; color: var(--trac-text-muted); margin-top: 0.25rem;">
                                    Combinação de repetibilidade amostral (Tipo A) com incertezas de balança, temperatura e menisco (Tipo B) com k&asymp;2.02 (95.45%).
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        if (!UserContext.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
        }
    }
}