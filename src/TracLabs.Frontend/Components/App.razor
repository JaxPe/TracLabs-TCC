<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="css/themes.css" />
    <link rel="stylesheet" href="@Assets["TracLabs.Frontend.styles.css"]" />
    
    <!-- Pre-hydration synchronous theme initializer (Prevents FOUC) -->
    <script>
        (function () {
            try {
                var theme = localStorage.getItem('traclabs_theme') || 
                    (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
                document.documentElement.setAttribute('data-theme', theme);
                document.documentElement.setAttribute('data-style', 'precision-slate');
            } catch (e) {
                document.documentElement.setAttribute('data-theme', 'light');
                document.documentElement.setAttribute('data-style', 'precision-slate');
            }
        })();
    </script>
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="js/theme.js"></script>
    <script src="js/pdfViewer.js"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
