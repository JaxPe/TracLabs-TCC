@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager Navigation
@implements IDisposable

<nav class="trac-breadcrumbs" aria-label="breadcrumb">
    <a href="/" class="trac-breadcrumb-item" style="color: var(--trac-text-secondary); text-decoration: none;">TracLabs</a>
    
    @foreach (var crumb in _breadcrumbs)
    {
        <span class="trac-breadcrumb-sep">/</span>
        @if (crumb.IsLast)
        {
            <span class="trac-breadcrumb-item active">@crumb.Title</span>
        }
        else
        {
            <a href="@crumb.Url" class="trac-breadcrumb-item" style="color: var(--trac-text-secondary); text-decoration: none;">@crumb.Title</a>
        }
    }
</nav>

@code {
    private record BreadcrumbItem(string Title, string Url, bool IsLast);
    private List<BreadcrumbItem> _breadcrumbs = new();

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += HandleLocationChanged;
        BuildBreadcrumbs();
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        BuildBreadcrumbs();
        InvokeAsync(StateHasChanged);
    }

    private void BuildBreadcrumbs()
    {
        _breadcrumbs.Clear();
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        var segments = relative.Split('?', '#')[0].Split('/', StringSplitOptions.RemoveEmptyEntries);

        if (segments.Length == 0)
        {
            _breadcrumbs.Add(new BreadcrumbItem("Início", "/", true));
            return;
        }

        var runningUrl = "";
        for (int i = 0; i < segments.Length; i++)
        {
            var seg = segments[i];
            runningUrl += $"/{seg}";
            var title = FormatTitle(seg);
            _breadcrumbs.Add(new BreadcrumbItem(title, runningUrl, i == segments.Length - 1));
        }
    }

    private static string FormatTitle(string segment) => segment.ToLowerInvariant() switch
    {
        "dashboard" => "Dashboard Metrológico",
        "cadastros" => "Cadastros",
        "calibracao" => "Calibração Volumétrica (ISO 4787 / 8655)",
        "certificados" => "Certificados Metrológicos",
        "login" => "Login / Perfis",
        _ => char.ToUpper(segment[0]) + segment[1..]
    };

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
