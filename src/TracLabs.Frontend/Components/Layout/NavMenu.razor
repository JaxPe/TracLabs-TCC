@using Microsoft.AspNetCore.Components.Routing

<aside class="trac-sidebar @(IsCollapsed ? "collapsed" : "")">
    <!-- Brand Header -->
    <a href="/" class="trac-sidebar-brand">
        <!-- Metrological Flask/Balance SVG -->
        <svg class="trac-nav-icon" style="color: var(--trac-brand-primary);" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                  d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
        </svg>
        @if (!IsCollapsed)
        {
            <div class="d-flex align-items-center gap-2">
                <span>TracLabs</span>
            </div>
        }
    </a>

    <!-- Navigation List -->
    <ul class="trac-nav">
        <li>
            <NavLink class="trac-nav-link" href="/" Match="NavLinkMatch.All" title="Página Inicial">
                <svg class="trac-nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
                @if (!IsCollapsed) { <span>Início</span> }
            </NavLink>
        </li>
        <li>
            <NavLink class="trac-nav-link" href="/dashboard" title="Dashboard Metrológico">
                <svg class="trac-nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                </svg>
                @if (!IsCollapsed) { <span>Dashboard</span> }
            </NavLink>
        </li>
        <li>
            <NavLink class="trac-nav-link" href="/cadastros" title="Cadastros (Clientes, Equipamentos, Padrões)">
                <svg class="trac-nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                </svg>
                @if (!IsCollapsed) { <span>Cadastros</span> }
            </NavLink>
        </li>
        <li>
            <NavLink class="trac-nav-link" href="/calibracao" title="Ensaio Gravimétrico (ISO 4787 / 8655)">
                <svg class="trac-nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
                </svg>
                @if (!IsCollapsed) { <span>Calibração Volumétrica</span> }
            </NavLink>
        </li>
        <li>
            <NavLink class="trac-nav-link" href="/certificados" title="Certificados de Calibração">
                <svg class="trac-nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                @if (!IsCollapsed) { <span>Certificados</span> }
            </NavLink>
        </li>
    </ul>

    <!-- Footer Toggle Button -->
    <div class="trac-sidebar-footer">
        <button class="trac-btn-icon" @onclick="OnToggleCollapse" title="@(IsCollapsed ? "Expandir Menu" : "Recolher Menu")" aria-label="Expandir ou Recolher Menu">
            <svg class="trac-nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                @if (IsCollapsed)
                {
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7" />
                }
                else
                {
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7" />
                }
            </svg>
        </button>
    </div>
</aside>

@code {
    [Parameter] public bool IsCollapsed { get; set; }
    [Parameter] public EventCallback OnToggleCollapse { get; set; }
}
