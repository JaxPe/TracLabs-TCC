POSTGRES_DB=traclabs
POSTGRES_USER=traclabs_user
POSTGRES_PASSWORD=traclabs_dev_password

# ── ASP.NET Core (usado pelo serviço api no Compose) ────────────────────────

# Define o ambiente — faz o runtime carregar appsettings.Development.json
ASPNETCORE_ENVIRONMENT=Development

# Porta interna que o Kestrel escuta (deve bater com o EXPOSE do Dockerfile)
ASPNETCORE_HTTP_PORTS=8080

# Connection string sobrescreve o appsettings.json.
# "db" é o nome do serviço PostgreSQL definido no compose.yaml —
# o Docker resolve esse hostname automaticamente dentro da rede interna.
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=traclabs;Username=traclabs_user;Password=traclabs_dev_password

# JWT — sobrescreve o appsettings.Development.json
# Gere este valor com o comando PowerShell documentado na Fase 2
JwtSettings__Secret=COLE_AQUI_SUA_SECRET_KEY
JwtSettings__Issuer=TracLabs.API
JwtSettings__Audience=TracLabs.Client
JwtSettings__ExpirationInHours=8
